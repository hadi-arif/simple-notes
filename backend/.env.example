# Salin file ini menjadi .env lalu sesuaikan nilainya:  cp .env.example .env

# --- Koneksi PostgreSQL ---
# Pengembangan lokal: isi DB_* di bawah (database dibuat otomatis kalau belum ada).
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=notes_db
# Gunakan "require" bila database mewajibkan SSL (biasanya begitu di layanan hosting).
DB_SSLMODE=disable

# Produksi: isi DATABASE_URL dari penyedia database, lalu DB_* di atas diabaikan.
# Contoh: postgres://user:password@host:5432/notes_db?sslmode=require
# DATABASE_URL=

# --- Keamanan ---
# Kunci rahasia untuk menandatangani token JWT. Ganti dengan teks acak yang panjang.
# Buat dengan: openssl rand -hex 32
# Di mode produksi (GIN_MODE=release) server menolak berjalan kalau ini kosong.
JWT_SECRET=ganti-dengan-teks-acak-yang-panjang

# --- Server ---
# Layanan hosting biasanya mengisi PORT sendiri.
PORT=8080
# Alamat frontend yang boleh mengakses API, pisahkan dengan koma (tanpa garis miring di akhir).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
